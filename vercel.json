{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "tanstack-start-lovable",
      "bindings": [
        {
          "type": "service",
          "service": "background-removal",
          "format": "url",
          "env": "BACKGROUND_REMOVAL_URL"
        }
      ]
    },
    "background-removal": {
      "root": "background-removal",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
